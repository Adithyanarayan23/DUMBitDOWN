# DumbItDown Environment Configuration
# ALL FREE - No paid APIs required!

# Required: Google Gemini API Key (FREE TIER)
# Get yours at: https://makersuite.google.com/app/apikey
# Free tier: 1,500 requests/day, 60 requests/minute
GOOGLE_API_KEY=your_google_api_key_here

# LLM provider: google (Gemini) or groq
LLM_PROVIDER=google
# GROQ_API_KEY=your_groq_api_key_here

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000

# Browser origins allowed to call the API (comma-separated). Do not use * in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Deployment Mode (local vs cloud)
# local = FAISS (file-based, works immediately, 60MB RAM)
# cloud = Qdrant (hosted, for production deploy, 1GB free tier)
DEPLOYMENT=local

# Local settings (used when DEPLOYMENT=local)
VECTOR_STORE_PATH=vector_store

# Cloud settings (used when DEPLOYMENT=cloud)
# Sign up for free at https://qdrant.tech/cloud/
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_key
QDRANT_COLLECTION=dumbitdown_papers

# Embedding Model (FREE - HuggingFace, runs locally)
# MUST match the model used to build vector_store/ (default MiniLM, no normalize)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NORMALIZE_EMBEDDINGS=false

# Gemini (primary + comma-separated fallbacks tried automatically)
GEMINI_MODEL=models/gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,models/gemini-1.5-flash,gemini-1.5-flash,gemini-pro

# Retrieval Settings
TOP_K=5
RERANK_TOP_N=3  # Final number of documents after reranking

# Conversation Database (SQLite, local file)
CONVERSATION_DB_PATH=conversations.db

# Interactive PDF document sessions
DOCUMENTS_DB_PATH=documents.db
UPLOADS_DIR=uploads
DOCUMENT_TTL_HOURS=24
MAX_INLINE_PAGES=25
